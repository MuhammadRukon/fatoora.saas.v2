{
  "name": "fatoora-saas-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "zatca:sim-check": "dotenv -e .env.dev -- tsx scripts/zatca-sim-check.ts",
    "zatca:sandbox-check": "tsx scripts/zatca-sim-check.ts --sandbox",
    "db:guard": "dotenv -e .env.dev -- tsx scripts/assert-db-target.ts",
    "predev": "npm run db:guard",
    "dev": "dotenv -e .env.dev -- next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e .env.dev -- vitest run",
    "test:watch": "dotenv -e .env.dev -- vitest",
    "predb:seed": "npm run db:guard",
    "db:seed": "dotenv -e .env.dev -- tsx prisma/seed.ts",
    "predb:studio": "npm run db:guard",
    "db:studio": "dotenv -e .env.dev -- prisma studio",
    "predb:migrate": "npm run db:guard -- --require-shadow",
    "db:migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "predb:deploy": "npm run db:guard",
    "db:deploy": "dotenv -e .env.dev -- prisma migrate deploy",
    "predb:status": "npm run db:guard",
    "db:status": "dotenv -e .env.dev -- prisma migrate status",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "asn1js": "^3.0.10",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pkijs": "^3.4.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.63.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@peculiar/x509": "^2.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^26.1.0",
    "prisma": "^6.17.0",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zatca-xml-js": "^0.1.9"
  }
}
