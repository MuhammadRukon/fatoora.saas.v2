# Copy this file to .env.dev for local development and fill in the values.
#   PowerShell / cmd:  copy .env.example .env.dev
#   bash:              cp .env.example .env.dev
# Production values live only in the Vercel dashboard. Never put production
# credentials in a local file. Every value below is a placeholder.

# Base
# Used by Auth.js as the canonical site URL.
NEXTAUTH_URL=http://localhost:3000

# A 32+ char random secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-a-random-32-char-string

# Optional fallback read by src/proxy.ts when NEXTAUTH_SECRET is unset.
# AUTH_SECRET=replace-me-with-a-random-32-char-string

# Trust the Host header. Auth.js trusts it automatically outside production;
# set to true on hosted deployments that run with NODE_ENV=production.
AUTH_TRUST_HOST=true

# Database (PostgreSQL). Local development only: the npm db/dev/test scripts
# refuse to run unless these point at localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fatoora_v2
# Needed only by `npm run db:migrate` (prisma migrate dev). Must differ from DATABASE_URL.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fatoora_v2_shadow

# OAuth (optional; only enable providers you need)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ZATCA credentials encryption (AES-256-GCM). Required: base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32
ZATCA_ENCRYPTION_KEY=replace-me-with-base64-of-32-random-bytes

# Bearer secret checked by the Vercel Cron retry route. Required in production.
CRON_SECRET=replace-me-with-a-random-string

# App
# Public canonical origin (robots, email links). Required.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed accounts used by `npm run db:seed`. Without the admin pair, prisma/seed.ts falls
# back to well-known default credentials, so always set your own. The USER pair
# is optional: when both are set, a verified demo USER is seeded too.
SEED_ADMIN_EMAIL=admin@fatoora.test
SEED_ADMIN_PASSWORD=admin12345
SEED_USER_EMAIL=user@fatoora.test
SEED_USER_PASSWORD=user12345

# Transactional email (Resend - https://resend.com). Optional: when unset,
# emails are logged and skipped instead of sent (dev/test mode).
# Until a sending domain is verified in Resend, use onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM=Fatoora <no-reply@example.com>

# Upstash Redis (REST, https://upstash.com). Optional and fail-open: when unset
# (or Redis is down) the app falls back to Postgres-backed behavior. No local setup needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
